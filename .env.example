# WazehTerms — environment template
#
# Documented names from docs/DEPLOYMENT.md §2. Placeholders only — never put
# real secret values in this file or anywhere in Git. Local development secrets
# belong in a git-ignored `api/.env`; deployment uses platform secret bindings
# (Secret Manager), per docs/DEPLOYMENT.md and docs/SECURITY.md.
#
# Every variable is optional at the infrastructure level, but each one degrades
# a capability when missing: the running service must expose its real state via
# GET /api/v1/capabilities instead of failing silently.

# --- Server-side secrets (Secret Manager at deploy; api/.env locally) --------

# Gemini API key. Missing → sample extraction returns 503 EXTRACTION_UNAVAILABLE.
GEMINI_API_KEY=

# Sanity organization token with Context Viewer access, for the Knowledge
# Base-only Context MCP endpoint (Phase 10). Missing → retrieval stage stays
# partial with an explicit source-review disclosure.
SANITY_ORGANIZATION_TOKEN=

# Separate minimum-privilege read token for canonical approved records
# (Phase 09/10, conditional — omit if the reviewed public read path is adequate).
SANITY_READ_TOKEN=

# High-entropy HMAC-SHA256 signing key for the extraction proof, plus its
# nonsecret keyId label in config. Missing → signed issuance unavailable.
REVIEW_HMAC_SECRET=

# --- Nonsecret server configuration ------------------------------------------

# Nonsecret label identifying the active signing key (keyId in proofs).
REVIEW_HMAC_KEY_ID=key-1

# Proof time-to-live in milliseconds; short, per docs/SECURITY.md §3.
REVIEW_TTL_MS=1800000

# Gemini model id used for extraction (release-config "model/prompt IDs" in
# docs/DEPLOYMENT.md §2; recorded per release).
GEMINI_MODEL=gemini-3.5-flash

# Application-facing Sanity Context MCP endpoint URL. Knowledge Base sources
# only — never a dataset source on this endpoint (docs/TECHNICAL_ARCHITECTURE.md).
SANITY_CONTEXT_MCP_URL=

# Canonical dataset holding curated reference records.
SANITY_PROJECT_ID=
SANITY_DATASET=

# Nonsecret Knowledge Base id retrieval queries address (Sanity → Context → your KB).
SANITY_KB_ID=

# --- Release flags (map to GET /api/v1/capabilities) ---------------------------

# Sample mode: allowlisted fictional samples. Initial posture: true.
SAMPLE_MODE_ENABLED=false

# Arbitrary custom uploads. Stays false until the PRD/SECURITY release gates
# pass (provider data-handling review, notice, cleanup, logs, tests). While
# false the API rejects every arbitrary file with 403 CUSTOM_UPLOAD_DISABLED.
CUSTOM_UPLOAD_ENABLED=false

# Independent release gates; false until their own evidence exists (ADR-009).
IMAGE_INPUT_ENABLED=false
URDU_EXPLANATION_ENABLED=false

# --- Limits and deadlines ------------------------------------------------------
# Illustrative names; final numbers come from staging measurement per
# docs/TESTING.md §4, not from docs/API.md example values.

MAX_BYTES_PER_FILE=
MAX_TOTAL_BYTES=
MAX_PAGES_PER_PDF=
MAX_CORRECTIONS=
APPLICATION_DEADLINE_MS=

# Version string of the public provider-processing notice in force.
PRIVACY_NOTICE_VERSION=
