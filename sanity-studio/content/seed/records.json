  {
    "_id": "rule.pk-oep-service-charges-bank-deposit.r1",
    "_type": "rule",
    "ruleKey": "pk-oep-service-charges-bank-deposit",
    "revision": 1,
    "title": "Pakistan: OEP service charges are bank-deposited, certification-bound, and refundable",
    "claimText": "Service charges for employment obtained through an overseas employment promoter are deposited in a bank; the promoter is reimbursed only on certification by the Protector of Emigrants that the employment was provided and joined, and deposited amounts are returned to the intending emigrant where the promoter fails to fulfil obligations under the rules.",
    "topic": "worker_costs",
    "relatedFieldKeys": [
      "recruitment_cost",
      "other_worker_charge"
    ],
    "ruleKind": "entitlement",
    "evidenceClass": "binding_official_rule",
    "jurisdiction": "PK",
    "origin": "PK",
    "destination": "AE",
    "employmentRegime": "unknown",
    "workerCategory": "unknown",
    "responsibleParty": "pakistan_recruiter",
    "conditions": [],
    "exceptions": [],
    "machineConditionKeys": [],
    "effectiveFrom": null,
    "effectiveTo": null,
    "currentGuidanceVerifiedAt": null,
    "primarySource": {
      "_type": "reference",
      "_ref": "source.pk-emigration-rules-1979.consolidated-2023"
    },
    "pinpoint": {
      "label": "Rule 15(1A) and the proviso thereto — Service Charges, their distribution etc.",
      "page": 12,
      "quote": "The overseas employment promoter or, as the case may be, Corporation on whose behalf their service charges are deposited in the bank under sub-rule (1) shall, subject to the proviso hereto, be entitled to reimbursement of the service charges only on certification by the Protector of Emigrants to the extent that the employment abroad has been provided to the emigrant and he has duly joined the same after registration with the protector of emigrant: Provided that where the overseas employment promoter or, as the case may be, the Corporation fail to fulfil his or its obligations in accordance with these rules, the deposited amount shall be returned to the intending emigrant."
    },
    "plainEnglish": "In Pakistan, service charges paid through an overseas employment promoter must be deposited in a bank — not handed to the agent as cash — and the promoter is paid from that deposit only after the Protector of Emigrants certifies you were given and have joined the job. If the promoter does not deliver, the deposit is returned to you. Keep the bank certificate and every receipt for the payment you make.",
    "sourceCheckedAt": "2026-09-29T00:00:00.000Z",
    "reviewStatus": "approved",
    "reviewedAt": "2026-09-30T00:00:00.000Z",
    "reviewerCode": "owner-1",
