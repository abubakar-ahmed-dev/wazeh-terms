    ],
    "origin": "PK",
    "pinpoint": {
      "label": "Article (6) Recruitment and Employment of Workers, clause (4)",
      "page": 8,
      "quote": "The Employer is prohibited from charging the Worker the fees and costs of recruitment and employment or collecting them from him, whether directly or indirectly."
