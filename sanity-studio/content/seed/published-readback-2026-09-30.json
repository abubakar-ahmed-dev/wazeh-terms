    "_id": "rule.ae-recruitment-costs-employer-bears.r1",
    "_type": "rule",
    "claimText": "A UAE employer must not charge or collect recruitment and employment fees or costs from the worker, directly or indirectly.",
    "conditions": [],
    "destination": "AE",
    "effectiveFrom": "2022-02-02",
    "employmentRegime": "uae_mainland_private",
